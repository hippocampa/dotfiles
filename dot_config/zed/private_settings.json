{
  "buffer_font_family": "Iosevka Nerd Font",
  "buffer_font_size": 15,
  "ui_font_size": 16,

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Xcode Classic Dark",
  },

  "icon_theme": "Zed (Default)",

  "vim_mode": true,
  "relative_line_numbers": "enabled",

  "session": {
    "trust_all_worktrees": true,
  },

  "lsp": {
    "dart": {
      "binary": {
        "path": "/home/teguh/fvm/bin/fvm",
        "arguments": ["dart", "language-server", "--protocol=lsp"],
      },
    },
  },
  "auto_install_extensions": {
    "dart": true,
    "git-firefly": true,
    "ruff": true,
    "xcode-themes": true,
    "toml": true,
  },
}
